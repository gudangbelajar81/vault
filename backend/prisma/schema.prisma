// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String     @id @default(uuid())
  email               String     @unique
  passwordHash        String
  recoveryCodes       String      @db.Text // JSON stringified array of hashed backup codes
  currentChallenge    String?     @db.Text // Store current FIDO2 challenge
  createdAt           DateTime    @default(now())
  updatedAt           DateTime   @updatedAt
  deletedAt           DateTime?

  sessions            Session[]
  vaultItems          VaultItem[]
  subscriptions       Subscription[]
  expenses            Expense[]
  webAuthnCredentials WebAuthnCredential[]
  workspaceSync       WorkspaceSync?
  employees           Employee[]
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String   @unique
  deviceInfo   String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

model WebAuthnCredential {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId  String   @unique
  publicKey     String   @db.Text
  counter       BigInt   @default(0)
  transports    String?
  deviceName    String?
  lastUsed      DateTime @default(now())
  createdAt     DateTime @default(now())
}

model VaultItem {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String   // password, api, course, shortcut, etc.
  title         String
  encryptedData String   @db.Text // JSON string containing encrypted fields (username, password, URL, notes)
  favorite      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?
}

model Subscription {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  price           Float
  currency        String   @default("IDR") // IDR, USD
  billingCycle    String   @default("monthly") // monthly, yearly
  nextBillingDate DateTime
  status          String   @default("active") // active, paused, cancelled
  accountEmail    String?  // Untuk relasi ke fitur Jalan Pintas (Mind Map)
  encryptedNotes  String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Expense {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  amount      Float
  currency    String   @default("IDR")
  category    String
  date        DateTime
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==========================================
// LICENSE MANAGER MODELS (Migrated from Railway)
// ==========================================

model License {
  id          Int      @id @default(autoincrement())
  client_name String   
  app_code    String   @default("APP_KASIR") 
  wa_number   String?  
  machine_id  String   
  tier        String   @default("BASIC") 
  license_key String   @db.Text
  created_at  DateTime @default(now())
}

model Package {
  id           Int     @id @default(autoincrement())
  tier_code    String  @unique 
  display_name String  
  price        Int     @default(0)
  features     String? @db.Text
}

model Otp {
  id          Int      @id @default(autoincrement())
  otp_code    String   @unique 
  machine_id  String   
  app_code    String   
  status      String?  @default("pending") 
  license_key String?  @db.Text
  created_at  DateTime @default(now())
  expires_at  DateTime
}

// ==========================================
// RUANG KERJA CLOUD SYNC
// ==========================================
// Catatan desain: Ruang Kerja (notes/pages/stickies/sheets/bookmarks/drawing)
// SENGAJA tidak dienkripsi di localforage (akses instan tanpa login/master password).
// Blob sync ini mengikuti filosofi yang sama -- disimpan plaintext di DB,
// BUKAN data sensitif seperti password/API key (yang sudah dienkripsi di VaultItem).
model WorkspaceSync {
  id         String   @id @default(uuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dataJson   String   @db.LongText // snapshot JSON lengkap (hasil exportAllData)
  deviceInfo String?
  syncedAt   DateTime @updatedAt
  createdAt  DateTime @default(now())
}

// ==========================================
// MENU KARYAWAN — GAJI & BON
// ==========================================
// Terinspirasi dari fitur "Gaji & Bon" di Garneta Store (POS), diadaptasi ke
// stack VaultPro (Prisma/MySQL). Mengelola profil karyawan, hari kerja
// (salaryType Harian/Bulanan), kasbon/bon (cash advance), dan riwayat payroll.
model Employee {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  phone       String?
  joinDate    DateTime
  salaryType  String   @default("Bulanan") // "Bulanan" | "Harian"
  baseSalary  Float    @default(0)
  status      String   @default("Aktif") // "Aktif" | "Nonaktif" | "Cuti"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cashAdvances CashAdvance[]
  payrolls     Payroll[]
}

model CashAdvance {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime
  amount     Float    @default(0)
  notes      String?  @db.Text
  status     String   @default("Belum Lunas") // "Belum Lunas" | "Lunas"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Payroll {
  id                     String    @id @default(uuid())
  employeeId             String
  employee               Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  periodStart            DateTime?
  periodEnd              DateTime?
  attendanceDays         Int       @default(0)
  basicSalaryCalculated  Float     @default(0)
  totalDeductionBon      Float     @default(0)
  netSalary              Float     @default(0)
  sisaBon                Float     @default(0)
  notes                  String?   @db.Text
  createdAt              DateTime  @default(now())
}

